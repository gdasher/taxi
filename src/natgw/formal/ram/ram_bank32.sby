[tasks]
bank32_p4
bank32_p5
bank32_p6

[options]
mode bmc
depth 20

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
bank32_p4: read_slang natgw_ram.sv formal_ram.sv --top formal_ram -G ADDR_W=6 -G BANK_AW=1 -G PIPE=4
bank32_p5: read_slang natgw_ram.sv formal_ram.sv --top formal_ram -G ADDR_W=6 -G BANK_AW=1 -G PIPE=5
bank32_p6: read_slang natgw_ram.sv formal_ram.sv --top formal_ram -G ADDR_W=6 -G BANK_AW=1 -G PIPE=6
prep -top formal_ram

[files]
../../rtl/natgw_ram.sv
formal_ram.sv
