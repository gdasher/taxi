[tasks]
bmc
data
cover
datacover

[options]
bmc: mode bmc
bmc: depth 22
data: mode bmc
data: depth 12
cover: mode cover
cover: depth 22
datacover: mode cover
datacover: depth 12

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
bmc: read_slang taxi_axis_if.sv taxi_axis_register.sv natgw_pkg.sv natgw_formal_ref_pkg.sv natgw_rewrite.sv formal_rewrite.sv --top formal_rewrite
cover: read_slang taxi_axis_if.sv taxi_axis_register.sv natgw_pkg.sv natgw_formal_ref_pkg.sv natgw_rewrite.sv formal_rewrite.sv --top formal_rewrite
datacover: read_slang taxi_axis_if.sv taxi_axis_register.sv natgw_pkg.sv natgw_formal_ref_pkg.sv natgw_rewrite.sv formal_rewrite.sv --top formal_rewrite -G NOSTALL=1
data: read_slang taxi_axis_if.sv taxi_axis_register.sv natgw_pkg.sv natgw_formal_ref_pkg.sv natgw_rewrite.sv formal_rewrite.sv --top formal_rewrite -G NOSTALL=1
prep -top formal_rewrite

[files]
../../lib/taxi/src/axis/rtl/taxi_axis_if.sv
../../lib/taxi/src/axis/rtl/taxi_axis_register.sv
../../rtl/natgw_pkg.sv
../common/natgw_formal_ref_pkg.sv
../../rtl/natgw_rewrite.sv
formal_rewrite.sv
