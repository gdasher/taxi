# natgw gateway VM settings, read by natgw-guest-setup.sh.
# Copy to /etc/natgw/deploy.env and edit before running the script.

# sources: the forks' branches (taxi, dpdk and vpp are cloned side by side;
# the dpdk branch links into the taxi checkout). NATGW_BRANCH is taxi's:
# natgw-ddr4 adds the DDR tier (with the fpga_AU200_nat_ddr bitstream; it
# also runs the fpga_AU200_nat one, on chip only). DPDK and VPP stay natgw.
NATGW_GIT_BASE=https://github.com/gdasher
NATGW_BRANCH=natgw-ddr4
NATGW_DPDK_BRANCH=natgw
NATGW_VPP_BRANCH=natgw
NATGW_SRC=/opt/natgw/src
NATGW_PREFIX=/opt/natgw

# LAN: VPP's address on the LAN lane, and this VM's management address
NATGW_LAN_CIDR=192.168.1.1/24
NATGW_LAN_NET=192.168.1.0/24
NATGW_MGMT_IF=enp1s0
NATGW_MGMT_CIDR=192.168.1.2/24
NATGW_DHCP_RANGE=192.168.1.100,192.168.1.199,12h
NATGW_DNS_UPSTREAM="1.1.1.1 9.9.9.9"

# VPP: the core it polls on (a vCPU pinned on the host, not CPU 0); the
# card's PCI address is detected (1234:c001)
NATGW_VPP_MAIN_CORE=2
# NAT session limit. Each session is two flows; the DDR bitstream holds 256k
# flows on chip and 4M in DDR, so 1M sessions (2M flows) can all be
# offloaded with room to spare. nat44-ed preallocates about 0.36 KB per
# session from VPP's main heap (NATGW_VPP_HEAP): 430 MB for 1M. Without the
# DDR tier (no DIMM, natgw_ddr=0) sessions beyond 128k stay in software.
NATGW_NAT_SESSIONS=1048576
NATGW_VPP_HEAP=2G
# 2 MiB hugepages: packet buffers and the flow tables' host state (about
# 0.3 GB for the DDR geometry plus 0.25 KB per flow: under 1 GB at 2M flows)
NATGW_HUGEPAGES_2M=2048

# DDR tier. Extra devargs for the card (cndm PMD), separated by commas:
# natgw_ddr=0 runs on the on-chip table only; the tier policy takes
# tier_policy=fill|balanced, onchip_high, onchip_low, demote_idle, promote_k,
# promote_n, migrate_budget, min_residency (see sw/README.md, DDR tier).
# Empty: the tier is used when its memory calibrates, with the balanced policy.
NATGW_CARD_DEVARGS=""
# UDP server ports whose sessions go straight to DDR and stay there (bulk
# transfers that need no on-chip counters), separated by spaces. None by default.
NATGW_BULK_UDP_PORTS=""

# lanes: CndmEthernet<n> is lane n of the card
NATGW_LAN_IF=CndmEthernet0
NATGW_WAN1_IF=CndmEthernet1
NATGW_WAN2_IF=CndmEthernet2

# DMA isolation in the VM: "viommu" (the VM has a virtual IOMMU, the default
# with the recommended VM settings) or "noiommu" (vfio no-IOMMU mode)
NATGW_IOMMU_MODE=viommu

# monitor web page (https://<address>:<port>/): what it listens on, addresses
# and/or interface names separated by spaces (an interface serves on each of
# its addresses; it waits until the interface has one). The default is the
# management interface: anyone on the LAN can read it (no login). Use
# 127.0.0.1 to reach it only through an SSH tunnel.
NATGW_MONITOR_BIND="enp1s0"
NATGW_MONITOR_PORT=8443
# HTTPS certificate and key (PEM). Empty: a self-signed certificate for this
# VM's name and management address is created in /etc/natgw/tls (once).
# NATGW_MONITOR_TLS=no serves plain HTTP (not recommended beyond 127.0.0.1).
NATGW_MONITOR_CERT=""
NATGW_MONITOR_KEY=""
NATGW_MONITOR_TLS=yes

# FPGA updates: the Proxmox host and this VM's id there (natgw-fpga stage)
NATGW_PVE_HOST=192.168.1.3
NATGW_VMID=100
