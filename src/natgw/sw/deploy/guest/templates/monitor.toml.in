# natgw monitor (generated by natgw-guest-setup.sh from /etc/natgw/deploy.env
# on every run: change NATGW_MONITOR_* there and run the script again with
# --no-build). See natgw_monitor/config.py for every setting.

[http]
# addresses and/or interface names; an interface serves on its addresses
bind = [@NATGW_MONITOR_BIND_TOML@]
port = @NATGW_MONITOR_PORT@

[tls]
enabled = @NATGW_MONITOR_TLS@
cert = "@NATGW_MONITOR_CERT@"
key = "@NATGW_MONITOR_KEY@"

[sources]
stats_socket = "/run/vpp/stats.sock"
wanmgr_status = "/run/natgw-wanmgr.json"

[store]
# monitor.db there: 1 s samples for raw_hours, minute summaries, counter
# snapshots and events for retention_days (about 40 MB in all)
state_dir = "/var/lib/natgw-monitor"
raw_hours = 24
retention_days = 7
flush_seconds = 10
history_seconds = 3600

[alerts]
sample_interval = 1.0
hold_seconds = 300
onchip_fill_pct = 85
onchip_fill_seconds = 60
wanmgr_stale_seconds = 15
