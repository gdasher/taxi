# natgw WAN manager (generated by natgw-guest-setup.sh; edit freely, the
# script does not overwrite an existing file)
[vpp]
api_socket = "/run/vpp/api.sock"
api_dir = "@NATGW_PREFIX@/vpp/share/vpp/api"

[probe]
interval = 2.0
timeout = 0.5
up_rounds = 5
down_rounds = 3

[nat]
vrf_id = 0

# probe targets: reachable from the internet, each owned by one WAN
[[wan]]
name = "wan1"
interface = "@NATGW_WAN1_IF@"
probe_targets = ["1.1.1.1", "9.9.9.9"]

[[wan]]
name = "wan2"
interface = "@NATGW_WAN2_IF@"
probe_targets = ["1.0.0.1", "149.112.112.112"]

[alerts]
# fill in to receive email alerts; syslog always gets them
smtp_host = ""
smtp_port = 587
starttls = true
username = ""
password = ""
sender = "natgw@localhost"
recipients = []
max_per_hour = 10
hostname = "natgw"
