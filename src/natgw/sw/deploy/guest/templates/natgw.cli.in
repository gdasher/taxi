comment { natgw VPP startup commands (generated by natgw-guest-setup.sh) }

comment { LAN }
set interface state @NATGW_LAN_IF@ up
set interface ip address @NATGW_LAN_IF@ @NATGW_LAN_CIDR@

comment { WANs: addresses, DHCP clients and NAT pool entries come from natgw-wanmgr. }
comment { Below each: its cloned MAC, an address to reach a device's management on its }
comment { segment, and routes straight out of it, when deploy.env sets them. }
comment { WAN1 }@NATGW_WAN1_CLI@
set interface state @NATGW_WAN1_IF@ up
comment { WAN2 }@NATGW_WAN2_CLI@
set interface state @NATGW_WAN2_IF@ up

comment { NAT only as an output feature on the WANs, with no inside interface }
nat44 plugin enable sessions @NATGW_NAT_SESSIONS@
set interface nat44 out @NATGW_WAN1_IF@ output-feature
set interface nat44 out @NATGW_WAN2_IF@ output-feature

comment { WAN ingress: drop packets addressed straight to the LAN, or to the ISP devices' }
comment { management addresses (the WANs' extra addresses' subnets and routes) }
set acl-plugin acl @NATGW_WAN_ACL@deny src 0.0.0.0/0 dst @NATGW_LAN_NET@, permit src 0.0.0.0/0 dst 0.0.0.0/0
set acl-plugin interface @NATGW_WAN1_IF@ input acl 0
set acl-plugin interface @NATGW_WAN2_IF@ input acl 0
