# natgw VPP startup configuration (generated by natgw-guest-setup.sh)
unix {
  nodaemon
  log /var/log/vpp/vpp.log
  full-coredump
  cli-listen /run/vpp/cli.sock
  gid vpp
  exec /etc/vpp/natgw.cli
}
api-segment { gid vpp }
socksvr { socket-name /run/vpp/api.sock }
statseg { size 256M }

# main thread only: the natgw offload path is tested without worker threads
cpu { main-core @NATGW_VPP_MAIN_CORE@ }

buffers { buffers-per-numa 65536 }

dpdk {
  dev @NATGW_CARD_BDF@
  uio-driver vfio-pci
}

plugins {
  plugin default { disable }
  plugin dpdk_plugin.so { enable }
  plugin nat_plugin.so { enable }
  plugin natgw_offload_plugin.so { enable }
  plugin dhcp_plugin.so { enable }
  plugin ping_plugin.so { enable }
  plugin acl_plugin.so { enable }
}

natgw-offload {
  enable
  active-packets 4
  sync-interval 1
}
