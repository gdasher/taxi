# natgw gateway VM management address (generated by natgw-guest-setup.sh)
network:
  version: 2
  ethernets:
    @NATGW_MGMT_IF@:
      dhcp4: false
      addresses: [@NATGW_MGMT_CIDR@]
      routes:
        - to: default
          via: @NATGW_LAN_GW@
      nameservers:
        addresses: [@NATGW_MGMT_IP@]
